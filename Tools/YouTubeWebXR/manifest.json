{
  "manifest_version": 3,
  "name": "SwiftXR YouTube WebXR",
  "version": "0.2.0",
  "description": "Streams live web video into generic macOS OpenXR WebXR without yt-dlp.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube_webxr.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:49375/*"
  ]
}
